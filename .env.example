# AudioQualityVote — local development environment template
# Copy to `.env` (git-ignored), fill in operator values, then load it into the
# invoking shell before invoking Gradle (the application reads only the
# process environment — never this file):
#   set -a; . ./.env; set +a; ./gradlew --no-daemon :audio-quality-vote-war:appStart
# Placeholders only — no real values here.

# Database connection (all keys required)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=audiovote
DB_USER=audiovote

# Password — exactly one form:
# Direct form (local development only):
DB_PASSWORD=change-me
# Production form: path to an operator-held secret file (exclusive with DB_PASSWORD):
#DB_PASSWORD_FILE=/run/secrets/db_password

# Audio file folder — an existing readable directory the ingest scan walks
# (required; a missing value breaks the scan, logged per cycle):
AUDIO_FOLDER=/tmp/opencode/aqv-audio

# GitHub OAuth application (server side; same application as the compiled
# client constant):
# Public client id — falls back to the compiled constant when unset:
#GITHUB_CLIENT_ID=Ov23liXXXXXXXXXXXXXX
# Client secret — exactly one form:
# Direct form (local development only):
GITHUB_CLIENT_SECRET=change-me
# Production form: path to an operator-held secret file (preferred when both set):
#GITHUB_CLIENT_SECRET_FILE=/run/secrets/github_client_secret
