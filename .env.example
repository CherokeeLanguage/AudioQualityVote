# AudioQualityVote — local development environment template
# Copy to `.env` (git-ignored), fill in operator values, then load it into the
# invoking shell before invoking Gradle (the application reads only the
# process environment — never this file):
#   set -a; . ./.env; set +a; ./gradlew --no-daemon :audio-quality-vote-war:appStart
# Placeholders only — no real values here.

# Database connection (all keys required)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=audiovote
DB_USER=audiovote

# Password — exactly one form:
# Direct form (local development only):
DB_PASSWORD=change-me
# Production form: path to an operator-held secret file (exclusive with DB_PASSWORD):
#DB_PASSWORD_FILE=/run/secrets/db_password
